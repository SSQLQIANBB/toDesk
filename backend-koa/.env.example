# 后端本地开发环境变量模板
#
# 配置位置：backend-koa/.env.local
# 创建方式：进入 backend-koa 后执行 `cp .env.example .env.local`。
# 加载方式：`pnpm dev` 会自动读取 .env.local；真实文件已被 Git 忽略。
# 如果使用团队共享的开发 MySQL/Redis，地址和账号向该环境管理员获取；不要使用生产环境密钥。
# 复制后必须替换所有 change-me 占位值；统一配置模块会在进程启动前完成类型转换和合法性校验。
# 业务代码只允许从 src/config/env.ts 导入配置，不要直接读取 process.env。

# [可选：服务端口] 前端 Vite 代理默认连接 http://localhost:3000。
PORT=3000
NODE_ENV=development

# [必填：MySQL] 填写开发者本机或团队开发库的连接信息。
# 本机数据库时通常使用 localhost:3306；账号、密码由本机初始化设置或开发环境管理员提供。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=todesk
DB_USER=root
DB_PASSWORD=change-me-local-mysql-password

# [可选：本地数据库行为] 本地首次建库可临时启用；不要照搬到生产环境。
DB_AUTO_CREATE=true
DB_SYNC_ALTER=false
DB_LOGGING=false

# [必填：Redis] 填写开发者本机或团队开发 Redis 的连接信息。
# 无密码的本机 Redis 可将 REDIS_PASSWORD 留空；团队开发环境密码向管理员获取。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# [必填：本地 JWT 密钥] 两个值必须不同；本地可执行两次 `openssl rand -hex 32` 生成。
JWT_SECRET=change-me-local-jwt-secret
REFRESH_TOKEN_SECRET=change-me-local-refresh-token-secret

# [按需：验证码邮件] 开发邮箱登录、注册、绑定或找回密码功能时必须配置。
# QQ 邮箱获取方式：网页版邮箱 > 设置 > 账号与安全 > 开启 SMTP 服务并生成授权码。
# SMTP_PASSWORD 是授权码，不是邮箱登录密码；不调试邮件功能时可整段留空。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
