# 本地 Docker Compose 开发环境变量模板
#
# 配置位置：仓库根目录 .env
# 创建方式：cp .env.example .env
# 使用场景：在仓库根目录执行 `docker compose up`。真实 .env 已被 Git 忽略，每位开发者各自维护。
# 本文件所有密码都只用于本机开发，不要复用生产环境密码。
# 复制后必须替换所有 change-me 占位值；后端会在启动阶段拒绝示例密钥。

# [必填：本地 MySQL root 密码] 首次启动本地 MySQL 数据卷时使用。
# 获取方式：开发者自行设置；可用 `openssl rand -hex 16` 生成。
MYSQL_ROOT_PASSWORD=change-me-local-mysql-password

# [可选：本地数据库名] 没有特殊需要时保留默认值。
DB_NAME=todesk

# [必填：本地 JWT 密钥] 两个值必须不同。
# 生成方式：分别执行两次 `openssl rand -hex 32`。
JWT_SECRET=change-me-local-jwt-secret
REFRESH_TOKEN_SECRET=change-me-local-refresh-token-secret

# [必填：七牛对象存储] 本地后端上传文件也直接写入项目固定的七牛 Kodo 空间。
# 空间名和签名有效期统一维护在 backend-koa/src/config/qiniu.ts；
# 获取方式：七牛云控制台 > 对象存储 > 空间管理；
# 在域名管理中取得对应域名，在个人中心 > 密钥管理取得服务端 AccessKey/SecretKey。
# 这些值只会传给后端，禁止使用 VITE_ 前缀。
FILES_DOMAIN=files-dev.example.com
PRIVATE_FILES_DOMAIN=private-files-dev.example.com
QINIU_ACCESS_KEY=change-me-qiniu-access-key
QINIU_SECRET_KEY=change-me-qiniu-secret-key

# [按需：验证码邮件] 使用本地 Docker 调试邮箱登录、注册、绑定或找回密码时配置。
# QQ 邮箱获取方式：网页版邮箱 > 设置 > 账号与安全 > 开启 SMTP 服务并生成授权码。
# SMTP_PASSWORD 是授权码，不是邮箱登录密码；不调试邮件功能时可保留空值。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# [可选：前端请求地址] 留空时浏览器使用当前站点地址，由容器内 Nginx 转发 API 和 Socket。
# 只有前后端分开部署到不同源时，才填写可被浏览器访问的完整地址，例如 http://192.168.1.10:3000。
# VITE_* 会打包进前端代码，绝对不能填写任何密码或 AccessKey。
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# [可选：本机访问端口] 获取方式：选择本机未被占用的端口；默认使用 80。
HTTP_PORT=80
