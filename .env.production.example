NODE_ENV=production
PORT=3000

# Public domain, without http:// or https://
DOMAIN=desk.example.com

# Qiniu Kodo source domains. Keep their CNAME records pointing to Qiniu.
FILES_DOMAIN=files.example.com
PRIVATE_FILES_DOMAIN=private-files.example.com

# A least-privilege AliDNS RAM user used only for ACME DNS-01 challenges.
ALIYUN_ACCESS_KEY_ID=change-me-alidns-access-key-id
ALIYUN_ACCESS_KEY_SECRET=change-me-alidns-access-key-secret

# Server-level shared infrastructure network
SHARED_SERVICES_NETWORK=shared-services

# MySQL
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=todesk
DB_USER=todesk
DB_PASSWORD=change-me-todesk-db-password
DB_AUTO_CREATE=false
DB_SYNC_ALTER=false
DB_LOGGING=false

# Redis
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=1

# JWT
JWT_SECRET=change-me-with-a-long-random-secret
REFRESH_TOKEN_SECRET=change-me-with-another-long-random-secret

# QQ 邮箱：先在 QQ 邮箱设置中开启 SMTP 服务，使用授权码而非登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@qq.com
SMTP_PASSWORD=change-me-qq-mail-authorization-code
SMTP_FROM=ToDesk <your-account@qq.com>
